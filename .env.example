# 질의에 사용할 엔진 (키 있는 것만 자동 활성화)
OPENAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=

# provider별 모델 (비우면 각 provider의 합리적 기본값 사용:
#   openai=gpt-4o, gemini=gemini-2.5-flash, perplexity=sonar)
OPENAI_MODEL=
GEMINI_MODEL=
PERPLEXITY_MODEL=

# 리포트 생성에 쓸 provider/model (질의 엔진 중 하나, 기본 gemini)
REPORT_PROVIDER=gemini
REPORT_MODEL=

# (선택) OpenAI 웹검색 도구 타입 — 계정에 따라 web_search_preview 일 수 있음
# OPENAI_WEB_SEARCH_TYPE=web_search
