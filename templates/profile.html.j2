<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
{% if has_photo %}
<meta property="og:image" content="{{ photo_url }}">
{% endif %}
{% if site_url %}
<meta property="og:url" content="{{ site_url }}">
{% endif %}
<meta name="twitter:card" content="summary">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F4F1EC; --paper:#FCFAF6; --ink:#2A2622; --muted:#8C8479;
    --line:#E6DFD4; --accent:#6E5B47; --accent-d:#4E4031; --soft:#EFE9DF;
    --sans:'Pretendard',-apple-system,'Apple SD Gothic Neo',sans-serif;
    --serif:'Cormorant Garamond',serif;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
    font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:600px;margin:0 auto;background:var(--paper);min-height:100vh;
    box-shadow:0 0 60px rgba(42,38,34,.06);}
  .pad{padding:0 30px;}

  /* hero */
  header{padding:54px 30px 36px;text-align:center;border-bottom:1px solid var(--line);}
  .ava{width:120px;height:120px;border-radius:50%;object-fit:cover;margin:0 auto 20px;
    display:block;background:var(--soft);border:1px solid var(--line);}
  .ava-ph{width:120px;height:120px;border-radius:50%;margin:0 auto 20px;background:var(--soft);
    display:flex;align-items:center;justify-content:center;font-family:var(--serif);
    font-size:42px;color:var(--accent);border:1px solid var(--line);}
  h1{font-family:var(--serif);font-size:40px;font-weight:600;margin:0;letter-spacing:.5px;}
  .ko-name{font-size:15px;color:var(--muted);margin:2px 0 14px;letter-spacing:3px;}
  .role{font-size:15px;font-weight:600;color:var(--accent);}
  .salon{font-size:14px;color:var(--muted);margin-top:2px;}
  .tagline{font-size:15px;color:var(--ink);margin:20px auto 0;max-width:440px;line-height:1.7;}

  /* cta */
  .cta-row{display:flex;gap:10px;padding:24px 30px 6px;}
  .cta{flex:1;text-align:center;padding:14px 10px;border-radius:12px;font-size:15px;
    font-weight:600;text-decoration:none;transition:transform .15s,opacity .15s;display:block;}
  .cta:active{transform:scale(.98);}
  .cta-primary{background:var(--accent);color:#fff;}
  .cta-ghost{background:var(--soft);color:var(--accent-d);}

  section{padding:34px 30px;border-top:1px solid var(--line);}
  .eyebrow{font-family:var(--serif);font-size:13px;letter-spacing:3px;text-transform:uppercase;
    color:var(--accent);margin-bottom:16px;font-weight:600;}
  h2{font-size:19px;font-weight:700;margin:0 0 14px;}

  /* specialties */
  .spec{margin:0 0 16px;}
  .spec:last-child{margin-bottom:0;}
  .spec .name{font-weight:700;font-size:15.5px;margin-bottom:3px;}
  .spec .name .badge{font-family:var(--serif);font-style:italic;font-size:13px;color:var(--accent);
    margin-left:8px;letter-spacing:.5px;font-weight:500;}
  .spec .desc{font-size:14.5px;color:var(--muted);line-height:1.6;}

  /* about */
  .about-list{list-style:none;padding:0;margin:0;}
  .about-list li{position:relative;padding-left:18px;margin:9px 0;font-size:14.5px;color:var(--ink);}
  .about-list li::before{content:"";position:absolute;left:0;top:11px;width:5px;height:5px;
    border-radius:50%;background:var(--accent);}

  /* gallery placeholder */
  .gal{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;}
  .gal div{aspect-ratio:3/4;background:var(--soft);border-radius:6px;display:flex;
    align-items:center;justify-content:center;color:var(--muted);font-size:11px;text-align:center;padding:6px;}

  /* faq */
  .faq{border-bottom:1px solid var(--line);padding:14px 0;}
  .faq:first-of-type{padding-top:0;}
  .faq:last-child{border-bottom:none;padding-bottom:0;}
  .faq .q{font-weight:600;font-size:15px;margin-bottom:6px;}
  .faq .q::before{content:"Q. ";color:var(--accent);font-family:var(--serif);font-weight:600;}
  .faq .a{font-size:14.5px;color:var(--muted);line-height:1.65;}
  .faq .a.todo{font-style:italic;color:#B7AE9F;}

  /* location */
  .loc{font-size:14.5px;color:var(--ink);line-height:1.7;}
  .loc .lab{color:var(--muted);font-size:13px;}

  footer{padding:28px 30px 44px;text-align:center;border-top:1px solid var(--line);}
  footer a{color:var(--accent);text-decoration:none;font-weight:600;font-size:14px;}
  .note{font-size:11.5px;color:#B7AE9F;margin-top:14px;line-height:1.6;}

  @media (prefers-reduced-motion: no-preference){
    .reveal{opacity:0;transform:translateY(14px);animation:rise .7s ease forwards;}
    .r1{animation-delay:.05s}.r2{animation-delay:.13s}.r3{animation-delay:.21s}
    .r4{animation-delay:.29s}.r5{animation-delay:.37s}
  }
  @keyframes rise{to{opacity:1;transform:none;}}
{% if menu %}
  /* menu (시술 안내) — 입력에 menu 가 있을 때만 */
  .menu-item{display:flex;align-items:flex-start;gap:10px;padding:13px 0;border-bottom:1px solid var(--line);}
  .menu-item:last-child{border-bottom:none;}
  .menu-name{font-weight:700;font-size:15px;}
  .menu-desc{font-size:12.5px;color:var(--muted);margin-top:2px;}
  .menu-price{margin-left:auto;text-align:right;white-space:nowrap;padding-left:10px;}
  .menu-price .p{font-weight:700;font-size:14.5px;}
  .menu-price .t{font-size:12px;color:var(--muted);}
{% endif %}
{% if portfolio %}
  /* before/after 갤러리 — 입력에 portfolio 가 있을 때만 */
  .ba-gal{display:flex;flex-direction:column;gap:16px;}
  .ba-item{margin:0;}
  .ba-pair{position:relative;aspect-ratio:4/5;border-radius:10px;overflow:hidden;background:var(--soft);touch-action:none;}
  .ba-pair img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;user-select:none;-webkit-user-drag:none;}
  .ba-before{clip-path:inset(0 calc(100% - var(--pos,50%)) 0 0);}
  .ba-cap{position:absolute;top:10px;font-size:10.5px;font-weight:700;letter-spacing:1px;color:#fff;background:rgba(42,38,34,.4);padding:2px 8px;border-radius:5px;pointer-events:none;}
  .ba-cap.l{left:10px;} .ba-cap.r{right:10px;}
  .ba-line{position:absolute;top:0;bottom:0;left:var(--pos,50%);width:3px;background:#fff;transform:translateX(-50%);box-shadow:0 0 6px rgba(0,0,0,.3);pointer-events:none;}
  .ba-line::after{content:"⇆";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:32px;height:32px;border-radius:50%;background:#fff;color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 2px 8px rgba(0,0,0,.28);}
  .ba-range{position:absolute;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize;}
  .ba-item figcaption{font-size:13px;color:var(--muted);margin-top:8px;}
{% endif %}
{% if reviews %}
  /* reviews (고객 후기) — 입력에 reviews 가 있을 때만 */
  .rev-head{display:flex;align-items:center;gap:13px;margin-bottom:16px;}
  .rev-score{font-family:var(--serif);font-size:38px;font-weight:600;line-height:1;}
  .rev-stars{color:#C99A3E;letter-spacing:1px;font-size:14px;}
  .rev-count{font-size:12px;color:var(--muted);}
  .review{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-bottom:10px;background:#fff;}
  .review:last-child{margin-bottom:0;}
  .review .rev-q{font-size:14px;line-height:1.6;margin:5px 0;}
  .review .rev-by{font-size:12px;color:var(--muted);}
{% endif %}
{% if style_quiz %}
  /* style quiz (어울리는 스타일 찾기) — 입력에 style_quiz 가 있을 때만 */
  .quiz-dots{display:flex;gap:6px;justify-content:center;margin-bottom:16px;}
  .quiz-dots i{width:7px;height:7px;border-radius:50%;background:var(--line);transition:.2s;}
  .quiz-dots i.on{background:var(--accent);width:20px;border-radius:6px;}
  .quiz-intro{font-size:13px;color:var(--muted);text-align:center;margin:0 0 14px;}
  .quiz-q{font-size:17px;font-weight:700;text-align:center;margin-bottom:16px;}
  .quiz-opts{display:flex;flex-direction:column;gap:9px;}
  .quiz-opt{border:1px solid var(--line);border-radius:12px;padding:12px 15px;font-size:14px;color:var(--ink);background:#fff;font-family:inherit;text-align:left;cursor:pointer;transition:.15s;}
  .quiz-opt:hover{border-color:var(--accent);background:var(--soft);}
  .quiz-opt:active{transform:scale(.99);}
  .quiz-result{text-align:center;padding:6px 0;}
  .quiz-result-e{font-family:var(--serif);font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--accent);font-weight:600;}
  .quiz-result-t{font-family:var(--serif);font-size:30px;font-weight:600;margin:4px 0 8px;}
  .quiz-result-d{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:16px;}
  .quiz-cta{display:inline-block;background:var(--accent);color:#fff;text-decoration:none;font-weight:700;font-size:14px;padding:12px 22px;border-radius:12px;}
  .quiz-again{display:block;margin:12px auto 0;background:none;border:none;color:var(--muted);font-size:12.5px;text-decoration:underline;cursor:pointer;font-family:inherit;}
{% endif %}
</style>
</head>
<body>
<div class="wrap">

  <header class="reveal r1">
    {% if has_photo %}
    <img class="ava" src="{{ photo_url }}" alt="{{ display_name }}">
    {% else %}
    <!-- 실제 발행 시 본인 사진 URL로 교체 -->
    <div class="ava-ph">{{ initial }}</div>
    {% endif %}
    <h1>{{ display_name }}</h1>
    <div class="ko-name">{{ korean_name }}</div>
    <div class="role">{{ role }}</div>
    <div class="salon">{{ salon }}</div>
    <p class="tagline">{{ tagline_html|safe }}</p>
  </header>

  <div class="cta-row reveal r1">
    <a class="cta cta-primary" href="{{ booking_href }}">예약하기</a>
    <a class="cta cta-ghost" href="{{ instagram_url }}">Instagram</a>
  </div>
  <div class="pad" style="text-align:center;padding-top:8px;padding-bottom:4px;">
    <span style="font-size:13px;color:var(--muted);">문의는 인스타그램 DM으로 편하게 주세요</span>
  </div>

  <section class="reveal r2">
    <div class="eyebrow">Specialties</div>
    <h2>전문 시술</h2>
    {% for s in specialties %}
    <div class="spec">
      <div class="name">{{ s.name }}{% if s.signature %} <span class="badge">signature</span>{% endif %}</div>
      <div class="desc">{{ s.desc }}</div>
    </div>
    {% endfor %}
  </section>

{% if style_quiz %}
  <section class="reveal r3">
    <div class="eyebrow">Find Your Style</div>
    <h2>어울리는 스타일 찾기</h2>
    <div class="quiz" id="style-quiz"></div>
    <script type="application/json" id="quiz-data">{{ style_quiz_json|safe }}</script>
  </section>

{% endif %}
{% if menu %}
  <section class="reveal r3">
    <div class="eyebrow">Menu</div>
    <h2>시술 안내</h2>
    {% for m in menu %}
    <div class="menu-item">
      <div>
        <div class="menu-name">{{ m.name }}{% if m.signature %} <span class="badge">signature</span>{% endif %}</div>
        {% if m.desc %}<div class="menu-desc">{{ m.desc }}</div>{% endif %}
      </div>
      <div class="menu-price"><div class="p">{{ m.price }}</div>{% if m.time %}<div class="t">{{ m.time }}</div>{% endif %}</div>
    </div>
    {% endfor %}
  </section>

{% endif %}
  <section class="reveal r3">
    <div class="eyebrow">About</div>
    <h2>소개</h2>
    <ul class="about-list">
      {% for item in about %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </section>

  <section class="reveal r3">
    <div class="eyebrow">Portfolio</div>
    <h2>작업</h2>
{% if portfolio %}
    <div class="ba-gal">
      {% for item in portfolio %}
      <figure class="ba-item">
        <div class="ba-pair" style="--pos:50%">
          <img class="ba-after" src="{{ item.after }}" alt="after">
          <img class="ba-before" src="{{ item.before }}" alt="before">
          <span class="ba-cap l">BEFORE</span>
          <span class="ba-cap r">AFTER</span>
          <span class="ba-line"></span>
          <input class="ba-range" type="range" min="0" max="100" value="50" aria-label="시술 전후 비교">
        </div>
        {% if item.caption %}<figcaption>{{ item.caption }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
{% else %}
    <div class="gal">
      {{ gallery_html|safe }}
    </div>
    <p style="font-size:12.5px;color:var(--muted);margin-top:12px;">※ 발행 시 인스타 대표 작업 사진으로 교체 (시술명 캡션 포함)</p>
{% endif %}
  </section>

{% if reviews %}
  <section class="reveal r4">
    <div class="eyebrow">Reviews</div>
    <h2>고객 후기</h2>
    <div class="rev-head">
      <div class="rev-score">{{ review_avg }}</div>
      <div>
        <div class="rev-stars">★★★★★</div>
        <div class="rev-count">후기 {{ review_count }}건</div>
      </div>
    </div>
    {% for rv in reviews %}
    <div class="review">
      <div class="rev-stars">{{ "★" * rv.stars }}{{ "☆" * (5 - rv.stars) }}</div>
      <div class="rev-q">"{{ rv.text }}"</div>
      <div class="rev-by">{{ rv.by }}{% if rv.service %} · {{ rv.service }}{% endif %}</div>
    </div>
    {% endfor %}
  </section>

{% endif %}
  <section class="reveal r4">
    <div class="eyebrow">FAQ</div>
    <h2>자주 묻는 질문</h2>
    {% for f in faq %}
    <div class="faq">
      <div class="q">{{ f.q }}</div>
      <div class="a">{{ f.a }}</div>
    </div>
    {% endfor %}
  </section>

  <section class="reveal r5">
    <div class="eyebrow">Location</div>
    <h2>오시는 길</h2>
    <p class="loc">
      <span class="lab">매장</span><br>{{ salon }}<br>
      <span class="lab">주소</span><br>{{ address }}<br>
      <span class="lab">예약</span><br><a href="{{ booking_href_loc }}" style="color:var(--accent);text-decoration:none;font-weight:600;">네이버 예약</a> · 카카오톡 채널 · 인스타 DM<br><span class="lab" style="display:block;margin-top:8px;">찾아오시는 길</span>{{ directions }}
    </p>
  </section>

  <footer class="reveal r5">
    <a href="{{ instagram_url }}">@{{ instagram }}</a>
    <p class="note">
      © {{ display_name }} · {{ salon }}<br>
      ※ [ ] 표시는 발행 전 실제 값으로 교체하세요 (사진·주소·예약 링크·FAQ 답변).<br>
      ※ 옛 매장 정보는 퇴사·입사 확정 후 적용하세요.
    </p>
  </footer>

</div>

<!-- AI·검색이 읽는 구조화 데이터 -->
<script type="application/ld+json">
{{ person_ld_json|safe }}
</script>
<script type="application/ld+json">
{{ faq_ld_json|safe }}
</script>
{% if portfolio %}
<script>
  document.querySelectorAll('.ba-range').forEach(function(r){
    var pair = r.closest('.ba-pair');
    r.addEventListener('input', function(){ pair.style.setProperty('--pos', r.value + '%'); });
  });
</script>
{% endif %}
{% if style_quiz %}
<script>
  (function(){
    var root = document.getElementById('style-quiz');
    var dataEl = document.getElementById('quiz-data');
    if(!root || !dataEl) return;
    var data;
    try { data = JSON.parse(dataEl.textContent); } catch(e){ return; }
    var qs = data.questions || [];
    var results = data.results || {};
    var votes = {}, step = 0;
    function esc(s){ var d=document.createElement('div'); d.textContent=s==null?'':s; return d.innerHTML; }
    function renderQuestion(){
      var q = qs[step] || {};
      var dots = qs.map(function(_,i){ return '<i class="'+(i<=step?'on':'')+'"></i>'; }).join('');
      var opts = (q.options||[]).map(function(o,i){
        return '<button class="quiz-opt" type="button" data-i="'+i+'">'+esc(o.label)+'</button>';
      }).join('');
      root.innerHTML =
        '<div class="quiz-dots">'+dots+'</div>'+
        ((step===0 && data.intro) ? '<p class="quiz-intro">'+esc(data.intro)+'</p>' : '')+
        '<div class="quiz-q">'+esc(q.q)+'</div>'+
        '<div class="quiz-opts">'+opts+'</div>';
      root.querySelectorAll('.quiz-opt').forEach(function(b){
        b.addEventListener('click', function(){
          var o = (q.options||[])[+b.getAttribute('data-i')] || {};
          votes[o.style] = (votes[o.style]||0) + 1;
          step++;
          (step < qs.length) ? renderQuestion() : renderResult();
        });
      });
    }
    function topStyle(){
      var best=null, bestN=-1;
      Object.keys(results).forEach(function(k){
        var n = votes[k]||0;
        if(n > bestN){ bestN=n; best=k; }
      });
      return best;
    }
    function renderResult(){
      var r = results[topStyle()] || {};
      var cta = data.booking ? '<a class="quiz-cta" href="'+esc(data.booking)+'">'+esc(r.cta_label||'이 스타일로 상담받기')+'</a>' : '';
      root.innerHTML =
        '<div class="quiz-result">'+
          '<div class="quiz-result-e">추천 스타일</div>'+
          '<div class="quiz-result-t">'+esc(r.title)+'</div>'+
          '<div class="quiz-result-d">'+esc(r.desc)+'</div>'+
          cta+
          '<button class="quiz-again" type="button">다시 해보기</button>'+
        '</div>';
      root.querySelector('.quiz-again').addEventListener('click', function(){
        votes={}; step=0; renderQuestion();
      });
    }
    renderQuestion();
  })();
</script>
{% endif %}
</body>
</html>
