<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}{{ designer }} · 카드{% endblock %}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F4F1EC; --paper:#FCFAF6; --ink:#2A2622; --muted:#8C8479;
    --line:#E6DFD4; --accent:#6E5B47; --accent-d:#4E4031; --soft:#EFE9DF;
    --serif:'Cormorant Garamond',serif;
    --sans:'Pretendard',-apple-system,'Apple SD Gothic Neo',sans-serif;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
    font-size:16px;line-height:1.65;-webkit-font-smoothing:antialiased;
    display:flex;justify-content:center;padding:28px 16px;min-height:100vh;}
  .phone{max-width:340px;width:100%;background:#fff;border-radius:34px;
    box-shadow:0 18px 44px rgba(42,38,34,.16);padding:10px;border:1px solid var(--line);height:max-content;}
  .screen{border-radius:26px;overflow:hidden;background:var(--paper);}
  .sc-pad{padding:20px 18px;}
  .badge{font-family:var(--serif);font-style:italic;font-size:12px;color:var(--accent);margin-left:6px;}

  .card{border:1px solid var(--line);border-radius:18px;background:#fff;overflow:hidden;}
  .cap-top{color:#fff;text-align:center;padding:20px 16px 16px;
    background:linear-gradient(135deg,#7A6A52,#574734);}
  .cap-top .e{font-family:var(--serif);font-size:11px;letter-spacing:2.5px;text-transform:uppercase;opacity:.85;}
  .cap-top .nm{font-family:var(--serif);font-size:24px;font-weight:600;margin-top:2px;}
  .cap-top .by{font-size:11.5px;opacity:.85;margin-top:1px;}
  .kv{padding:14px 18px;}
  .kv .r{display:flex;gap:12px;padding:9px 0;border-bottom:1px solid var(--line);}
  .kv .r:last-child{border-bottom:none;}
  .kv .k{flex:0 0 64px;font-size:12px;color:var(--muted);}
  .kv .v{font-size:13.5px;font-weight:600;}
  .save{padding:0 18px 18px;}
  .btn{display:block;text-align:center;font-size:13px;font-weight:700;padding:11px 18px;
    border-radius:11px;background:var(--accent);color:#fff;text-decoration:none;}
  {% block style %}{% endblock %}
</style>
</head>
<body>
<div class="phone"><div class="screen sc-pad">
{% block card %}{% endblock %}
</div></div>
</body>
</html>
