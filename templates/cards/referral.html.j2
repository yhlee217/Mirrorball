{% extends "_base.html.j2" %}
{% block title %}{{ customer }} 님 소개 카드 · {{ designer }}{% endblock %}
{% block style %}
  .ref{text-align:center;}
  .ref .ill{font-size:30px;margin:4px 0 6px;}
  .ref .line{font-size:14px;margin-bottom:14px;line-height:1.55;}
  .ref .line b{color:var(--accent);}
  .code{border:2px dashed var(--accent);border-radius:12px;padding:14px;margin:0 4px 14px;
    font-family:var(--serif);font-size:24px;font-weight:600;letter-spacing:2px;color:var(--accent-d);background:#fff;}
  .ref .small{font-size:11.5px;color:var(--muted);margin-top:10px;}
{% endblock %}
{% block card %}
  <div class="ref">
    <div class="ill">🎁</div>
    <div class="line">{{ customer }} 님이 친구를 소개하면<br><b>{{ offer }}</b></div>
    <div class="code">{{ code }}</div>
    {% if share_url %}<a class="btn" href="{{ share_url }}">친구에게 공유하기</a>{% endif %}
    <div class="small">{{ note | default('친구가 이 코드로 첫 방문하면 자동 적용돼요', true) }}</div>
  </div>
{% endblock %}
