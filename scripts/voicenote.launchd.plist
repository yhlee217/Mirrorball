<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mac 상시 음성메모 감시 서비스 (launchd). 로그인하면 자동 시작·crash 시 자동 재시작.
  설치:
    1) 아래 {PROJECT}/{FOLDER}/{SLUG}/{ANTHROPIC_API_KEY} 를 실제 값으로 바꾼다
    2) cp scripts/voicenote.launchd.plist ~/Library/LaunchAgents/com.mirrorball.voicenote.plist
    3) launchctl load ~/Library/LaunchAgents/com.mirrorball.voicenote.plist
  중지: launchctl unload ~/Library/LaunchAgents/com.mirrorball.voicenote.plist
  → 이후 '녹음만' 하면 끝. STT 를 매번 돌릴 필요 없음.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mirrorball.voicenote</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>{PROJECT}/voicenote.py</string>
    <string>watch</string>
    <string>{FOLDER}</string>
    <string>--client</string>
    <string>clients/{SLUG}</string>
  </array>
  <key>WorkingDirectory</key><string>{PROJECT}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ANTHROPIC_API_KEY</key><string>{ANTHROPIC_API_KEY}</string>
    <key>WHISPER_MODEL</key><string>base</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{PROJECT}/runs/voicenote.log</string>
  <key>StandardErrorPath</key><string>{PROJECT}/runs/voicenote.err.log</string>
</dict>
</plist>
