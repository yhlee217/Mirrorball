{
  "_": [
    "선불 원장 대조용 사례 — 파이썬(worker/txkind.ledger)과 웹(web/lib/tx.ledger)이",
    "같은 답을 내는지 확인하는 데 쓴다. 같은 알고리즘이 두 언어에 있으면 반드시 갈라지므로,",
    "기대값을 한 곳에 두고 양쪽 모두 이 파일로 검증한다(tests/test_rules_parity.py).",
    "새 규칙을 넣거나 경계를 바꾸면 여기에 사례부터 추가할 것."
  ],
  "cases": [
    {
      "name": "충전 30만 후 시술 10만 3회 — 실매출은 30만(이중계상 없음)",
      "items": [
        { "id": "c1", "date": "2026-01-01", "amount": 300000, "kind": "charge" },
        { "id": "s1", "date": "2026-02-01", "amount": 100000, "kind": "service" },
        { "id": "s2", "date": "2026-03-01", "amount": 100000, "kind": "service" },
        { "id": "s3", "date": "2026-04-01", "amount": 100000, "kind": "service" }
      ],
      "expect": { "balance": 0, "revenue": 300000, "charged": 300000, "covered": 300000 }
    },
    {
      "name": "잔액 소진 뒤 시술은 사비로 — 추정이 스스로 교정된다",
      "items": [
        { "id": "c1", "date": "2026-01-01", "amount": 300000, "kind": "charge" },
        { "id": "s1", "date": "2026-02-01", "amount": 100000, "kind": "service" },
        { "id": "s2", "date": "2026-03-01", "amount": 100000, "kind": "service" },
        { "id": "s3", "date": "2026-04-01", "amount": 100000, "kind": "service" },
        { "id": "s4", "date": "2026-05-01", "amount": 100000, "kind": "service" }
      ],
      "expect": { "balance": 0, "revenue": 400000, "charged": 300000, "covered": 300000 }
    },
    {
      "name": "'사비 결제' 표시는 잔액을 건드리지 않는다",
      "items": [
        { "id": "c1", "date": "2026-01-01", "amount": 300000, "kind": "charge" },
        { "id": "s1", "date": "2026-02-01", "amount": 100000, "kind": "service", "pocket": true }
      ],
      "expect": { "balance": 300000, "revenue": 400000, "charged": 300000, "covered": 0 }
    },
    {
      "name": "잔액이 모자라면 부족분만 사비",
      "items": [
        { "id": "c1", "date": "2026-01-01", "amount": 50000, "kind": "charge" },
        { "id": "s1", "date": "2026-02-01", "amount": 80000, "kind": "service" }
      ],
      "expect": { "balance": 0, "revenue": 80000, "charged": 50000, "covered": 50000 }
    },
    {
      "name": "같은 날 충전→시술은 시각 순서로 가린다",
      "items": [
        { "id": "s1", "date": "2026-01-01", "time": "11:00", "amount": 40000, "kind": "service" },
        { "id": "c1", "date": "2026-01-01", "time": "10:00", "amount": 100000, "kind": "charge" }
      ],
      "expect": { "balance": 60000, "revenue": 100000, "charged": 100000, "covered": 40000 }
    },
    {
      "name": "충전 이력이 없으면 전부 매출",
      "items": [{ "id": "s1", "date": "2026-02-01", "amount": 50000, "kind": "service" }],
      "expect": { "balance": 0, "revenue": 50000, "charged": 0, "covered": 0 }
    },
    {
      "name": "환불은 음수로 들어와 매출에서 빠진다",
      "items": [
        { "id": "s1", "date": "2026-01-01", "amount": 50000, "kind": "service" },
        { "id": "r1", "date": "2026-01-02", "amount": -50000, "kind": "refund" }
      ],
      "expect": { "balance": 0, "revenue": 0, "charged": 0, "covered": 0 }
    },
    {
      "name": "제품 구매도 잔액에서 차감된다",
      "items": [
        { "id": "c1", "date": "2026-01-01", "amount": 100000, "kind": "charge" },
        { "id": "p1", "date": "2026-02-01", "amount": 30000, "kind": "product" }
      ],
      "expect": { "balance": 70000, "revenue": 100000, "charged": 100000, "covered": 30000 }
    }
  ]
}
